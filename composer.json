{
    "name": "natnaeln4d/laravel-mail-customizer",
    "description": "A powerful Laravel package for creating and customizing email templates with Vue, React, and Blade support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Natnael Getachew",
            "email": "natnaeln4d@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "laravel/framework": "^9.0|^10.0|^11.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0",
        "orchestra/testbench": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Natnaeln4d\\MailCustomizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Natnaeln4d\\MailCustomizer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Natnaeln4d\\MailCustomizer\\MailCustomizerServiceProvider"
            ],
            "aliases": {
                "MailCustomizer": "Natnaeln4d\\MailCustomizer\\Facades\\MailCustomizer"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}